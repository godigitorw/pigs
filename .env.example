# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com,localhost,127.0.0.1

# Database Configuration
# For Render, this will be automatically set from the PostgreSQL service
DATABASE_URL=postgresql://user:password@host:port/database

# Deployment Platform Indicator
RENDER=true

# Optional: Railway Environment (if deploying to Railway instead)
# RAILWAY_ENVIRONMENT=production

# Optional: Vercel Environment (if deploying to Vercel instead)
# VERCEL=true
